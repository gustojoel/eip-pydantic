{
	"folders": [
		{
			"path": ".."
		}
	],
	"settings": {
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
		"python.envFile": "${workspaceFolder}/.env",
		"python.analysis.diagnosticMode": "workspace",
		"python.analysis.typeCheckingMode": "strict",
		"python.analysis.extraPaths": [
			".venv/lib/python3.13/site-packages/",
			".venv/lib64/python3.13/site-packages/"
		],
		"isort.args": [
            "--lines-after-imports",
            "3",
            "--line-length",
            "120",
            "--profile",
            "hug"
		],
		"python.analysis.addImport.exactMatchOnly": true,
		"python.analysis.autoImportCompletions": true,
		"python.analysis.autoImportUserSymbols": true,
		"python.analysis.completeFunctionParens": true,
		"python.analysis.inlayHints.variableTypes": false,
		"python.analysis.typeEvaluation.analyzeUnannotatedFunctions": true,
		"python.analysis.typeEvaluation.enableReachabilityAnalysis": true,
		"python.analysis.typeEvaluation.disableBytesTypePromotions": true,
		"python.analysis.typeEvaluation.deprecateTypingAliases": true,
		"python.analysis.typeEvaluation.strictDictionaryInference": true,
		"python.analysis.typeEvaluation.strictParameterNoneValue": false,
		"python.analysis.typeEvaluation.strictSetInference": true,
		"explorer.excludeGitIgnore": true,
		"files.exclude": {
			"**/.pytest_cache": true
		},
		"chat.tools.terminal.autoApprove": {
			"poetry": true
		}
	}

}